# Agent-Safe-Input 配置示例
#   放到 ~/.config/agent-safe-input/config（Windows 下为 C:/Users/<你>/.config/agent-safe-input/config）
#   环境变量优先：AGENT_SAFE_INPUT_SSH_TARGET / AGENT_SAFE_INPUT_SSH_ARGS / AGENT_SAFE_INPUT_REMOTE_DIR

# 目标机：user@host，或 ~/.ssh/config 里的 Host 别名
SSH_TARGET=user@192.168.1.10

# 额外 ssh 参数（可选）：指定私钥、端口、独立 ssh_config
# SSH_ARGS=-F ~/.ssh/config-vm
# SSH_ARGS=-i ~/.ssh/id_ed25519 -p 2222

# 远端队列目录（可选，默认 ~/.agent-safe-input/queue）
# REMOTE_DIR=~/.agent-safe-input/queue

# 界面语言只走环境变量，不在这里配置：
#   AGENT_SAFE_INPUT_LANG=zh_CN      （可选 en zh_CN zh_TW ja ko de fr es pt_BR ru）
# 不设则跟随系统（LC_ALL / LC_MESSAGES / LANGUAGE / LANG），认不出就用 en。
